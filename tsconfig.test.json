{
  /* The browser half's tests, and the harness they share. Same strictness as
     the app, plus the Node types they need: to check that the twelve plates are
     on disk, and to lend jsdom a `Blob` it does not have. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**/*.ts", "vitest.config.ts"],
  "exclude": []
}
